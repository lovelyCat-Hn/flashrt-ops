diff --git a/benchmarks/w8a16_skinny_sm87/main.cu b/benchmarks/w8a16_skinny_sm87/main.cu
new file mode 100644
index 00000000..a1253710
--- /dev/null
+++ b/benchmarks/w8a16_skinny_sm87/main.cu
@@ -0,0 +1,193 @@
+// Standalone micro-bench for w8a16_skinny (sm_87). Correctness vs fp64 CPU on
+// the same int8 weights; perf over the 5 decoder GEMM shapes × M ∈ {10, 50},
+// sweeping BN/BK variant × split_k.
+// Build:  nvcc -O3 -std=c++17 -arch=sm_87 -I../../csrc -Xcompiler "-O2 -fopenmp" \
+//             main.cu ../../csrc/gemm/w8a16_skinny_sm87.cu -o w8a16_bench
+// kernel 与 csrc/gemm/w8a16_skinny_sm87.cuh 同源（bench 只读引用，防漂移）
+#include "../../csrc/gemm/w8a16_skinny_sm87.cuh"
+
+#include <cuda_runtime.h>
+#include <cstdio>
+#include <cstdlib>
+#include <cmath>
+#include <random>
+#include <vector>
+
+struct Shape { const char* name; int N, K; };
+
+using GemmFn = int (*)(const void*, const void*, const float*, void*, float*,
+                       int, int, int, int, cudaStream_t);
+
+// gate M=50 sk=1 在 v1 出现 2 ULP worst relF（7.7e-3 vs 3.9e-3 基线）：
+// 多种子复核它是系统性错误还是 bf16 输出舍入的边界噪声。
+static void seed_check() {
+    const int M = 50, N = 4096, K = 1024;
+    const double ULP1 = 3.906e-3;   // 1 bf16 ULP 相对量
+    printf("== gate M=%d N=%d K=%d BN64/BK64 sk=1 多种子复核 ==\n", M, N, K);
+    std::mt19937 rng(42);
+    std::uniform_int_distribution<int> di(-127, 127);
+    std::uniform_real_distribution<float> df(-3.f, 3.f);
+    std::uniform_real_distribution<float> ds(0.0005f, 0.02f);
+    for (int seed : {42, 7, 2026}) {
+        rng.seed(seed);
+        std::vector<__nv_bfloat16> A((size_t)M * K);
+        for (auto& v : A) v = __float2bfloat16(df(rng));
+        std::vector<int8_t> Wq((size_t)N * K);
+        for (auto& v : Wq) v = (int8_t)di(rng);
+        std::vector<float> sc(N);
+        for (auto& v : sc) v = ds(rng);
+        std::vector<double> ref((size_t)M * N, 0.0);
+        #pragma omp parallel for collapse(2)
+        for (int n = 0; n < N; ++n)
+            for (int m = 0; m < M; ++m) {
+                double acc = 0.0;
+                for (int k = 0; k < K; ++k)
+                    acc += (double)__bfloat162float(A[(size_t)m * K + k]) *
+                           (double)Wq[(size_t)n * K + k];
+                ref[(size_t)m * N + n] = acc * (double)sc[n];
+            }
+        __nv_bfloat16 *dA; int8_t *dW; float *dsc, *dpart; __nv_bfloat16 *dD;
+        cudaMalloc(&dA, A.size() * 2);
+        cudaMalloc(&dW, Wq.size());
+        cudaMalloc(&dsc, N * 4);
+        cudaMalloc(&dpart, (size_t)M * N * 4);
+        cudaMalloc(&dD, (size_t)M * N * 2);
+        cudaMemcpy(dA, A.data(), A.size() * 2, cudaMemcpyHostToDevice);
+        cudaMemcpy(dW, Wq.data(), Wq.size(), cudaMemcpyHostToDevice);
+        cudaMemcpy(dsc, sc.data(), N * 4, cudaMemcpyHostToDevice);
+        flash_rt::w8a16_skinny::w8a16_skinny_gemm(dA, dW, dsc, dD, dpart,
+                                                  M, N, K, 1, 0);
+        std::vector<__nv_bfloat16> out((size_t)M * N);
+        cudaMemcpy(out.data(), dD, out.size() * 2, cudaMemcpyDeviceToHost);
+        double max_rel = 0, max_abs = 0;
+        long n1 = 0, n2 = 0;
+        size_t worst = 0;
+        for (size_t i = 0; i < out.size(); ++i) {
+            double got = (double)__bfloat162float(out[i]);
+            double e = fabs(got - ref[i]);
+            double rel = e / (fabs(ref[i]) + 1e-3);
+            if (rel > max_rel) { max_rel = rel; worst = i; }
+            if (e > max_abs) max_abs = e;
+            if (rel > ULP1) ++n1;
+            if (rel > 2 * ULP1) ++n2;
+        }
+        printf("  seed %-5d max_rel=%.2e max_abs=%.2e | >1ULP %ld  >2ULP %ld"
+               " / %zu | worst ref=%.4f got=%.4f\n",
+               seed, max_rel, max_abs, n1, n2, out.size(),
+               ref[worst], (double)__bfloat162float(out[worst]));
+        cudaFree(dA); cudaFree(dW); cudaFree(dsc); cudaFree(dpart); cudaFree(dD);
+    }
+}
+
+int main() {
+    cudaFree(0);
+    seed_check();
+
+    // decoder branch (pipeline_rtx.py): DEC_D=1024, DEC_NH=8, DEC_NKV=1,
+    // DEC_HD=256, DEC_H=4096
+    const Shape shapes[] = {
+        {"qkv ", 2560, 1024},
+        {"o   ", 1024, 2048},
+        {"gate", 4096, 1024},
+        {"up  ", 4096, 1024},
+        {"down", 1024, 4096},
+    };
+    const int Ms[] = {10, 50};
+    const int warmup = 20, iters = 200;
+    GemmFn fns[5] = {
+        flash_rt::w8a16_skinny::w8a16_skinny_gemm,
+        flash_rt::w8a16_skinny::w8a16_skinny_gemm_bn32,
+        flash_rt::w8a16_skinny::w8a16_skinny_gemm_bn64_bk128,
+        flash_rt::w8a16_skinny::w8a16_skinny_gemm_bn32_bk128,
+        flash_rt::w8a16_skinny::w8a16_skinny_gemm_bn128,
+    };
+    const char* fn_names[5] = {"BN64/BK64 ", "BN32/BK64 ", "BN64/BK128",
+                               "BN32/BK128", "BN128/BK64"};
+
+    printf("\n%-5s M  N    K    | var         split_k  us     totGB/s  relF_max\n",
+           "shape");
+    for (const Shape& sh : shapes) {
+        for (int M : Ms) {
+            const int N = sh.N, K = sh.K;
+            std::mt19937 rng(42);
+            std::uniform_int_distribution<int> di(-127, 127);
+            std::uniform_real_distribution<float> df(-3.f, 3.f);
+            std::uniform_real_distribution<float> ds(0.0005f, 0.02f);
+            std::vector<__nv_bfloat16> A(M * K);
+            for (auto& v : A) v = __float2bfloat16(df(rng));
+            std::vector<int8_t> Wq((size_t)N * K);
+            for (auto& v : Wq) v = (int8_t)di(rng);
+            std::vector<float> sc(N);
+            for (auto& v : sc) v = ds(rng);
+
+            __nv_bfloat16 *dA; int8_t *dW; float *dsc, *dpart; __nv_bfloat16 *dD;
+            cudaMalloc(&dA, A.size() * 2);
+            cudaMalloc(&dW, Wq.size());
+            cudaMalloc(&dsc, N * 4);
+            cudaMalloc(&dpart, (size_t)64 * M * N * 4);
+            cudaMalloc(&dD, (size_t)M * N * 2);
+            cudaMemcpy(dA, A.data(), A.size() * 2, cudaMemcpyHostToDevice);
+            cudaMemcpy(dW, Wq.data(), Wq.size(), cudaMemcpyHostToDevice);
+            cudaMemcpy(dsc, sc.data(), N * 4, cudaMemcpyHostToDevice);
+
+            // ── CPU fp64 reference ──
+            std::vector<double> ref((size_t)M * N, 0.0);
+            #pragma omp parallel for collapse(2)
+            for (int n = 0; n < N; ++n) {
+                for (int m = 0; m < M; ++m) {
+                    double acc = 0.0;
+                    for (int k = 0; k < K; ++k)
+                        acc += (double)__bfloat162float(A[(size_t)m * K + k]) *
+                               (double)Wq[(size_t)n * K + k];
+                    ref[(size_t)m * N + n] = acc * (double)sc[n];
+                }
+            }
+
+            double best_us = 1e30; int best_fn = -1, best_sk = 0;
+            double best_relF = 0;
+            for (int f = 0; f < 5; ++f) {
+                for (int sk : {1, 2, 4, 8, 16}) {
+                    if (K / 64 < sk) break;
+                    if (fns[f](dA, dW, dsc, dD, dpart, M, N, K, sk, 0)) continue;
+                    // correctness at this combo
+                    std::vector<__nv_bfloat16> out((size_t)M * N);
+                    cudaMemcpy(out.data(), dD, out.size() * 2, cudaMemcpyDeviceToHost);
+                    double rel = 0;
+                    for (size_t i = 0; i < out.size(); ++i) {
+                        double got = (double)__bfloat162float(out[i]);
+                        double e = fabs(got - ref[i]) / (fabs(ref[i]) + 1e-3);
+                        if (e > rel) rel = e;
+                    }
+                    for (int w = 0; w < warmup; ++w)
+                        fns[f](dA, dW, dsc, dD, dpart, M, N, K, sk, 0);
+                    cudaEvent_t t0, t1;
+                    cudaEventCreate(&t0); cudaEventCreate(&t1);
+                    cudaEventRecord(t0);
+                    for (int it = 0; it < iters; ++it)
+                        fns[f](dA, dW, dsc, dD, dpart, M, N, K, sk, 0);
+                    cudaEventRecord(t1);
+                    cudaEventSynchronize(t1);
+                    float ms; cudaEventElapsedTime(&ms, t0, t1);
+                    cudaEventDestroy(t0); cudaEventDestroy(t1);
+                    double us = ms * 1000.0 / iters;
+                    if (us < best_us) {
+                        best_us = us; best_fn = f; best_sk = sk; best_relF = rel;
+                    }
+                }
+            }
+
+            // 总流量（权重 int8 + partials 写读 + A 读）口径下的有效带宽
+            double sk_used = best_sk;
+            double traffic = (double)N * K                       // W int8
+                           + 2.0 * sk_used * M * N * 4           // partials w+r
+                           + (double)M * K * 2 * sk_used;        // A 每 split 重读
+            double gbs = traffic / best_us / 1000.0;
+            printf("%-5s %3d %4d %5d | %s sk=%-3d %7.2f %8.1f  %.2e\n",
+                   sh.name, M, N, K, fn_names[best_fn], best_sk, best_us, gbs,
+                   best_relF);
+
+            cudaFree(dA); cudaFree(dW); cudaFree(dsc); cudaFree(dpart); cudaFree(dD);
+        }
+    }
+    return 0;
+}
