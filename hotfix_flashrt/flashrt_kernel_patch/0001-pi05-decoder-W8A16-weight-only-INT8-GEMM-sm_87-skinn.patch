 =?UTF-8?q?EMM=EF=BC=88sm=5F87=20=E6=89=8B=E5=86=99=20skinny=20kernel?=
 =?UTF-8?q?=EF=BC=8Cenv=20=E9=97=A8=E6=8E=A7=E9=BB=98=E8=AE=A4=E5=85=B3?=
